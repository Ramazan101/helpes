# Безопасность и режим отладки
# В производственной среде обязательно замените ключ и установите DJANGO_DEBUG=False
DJANGO_SECRET_KEY=helpes-local-dev-secret-key-change-in-production-987654321
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Настройки базы данных
# Допустимые значения DB_ENGINE: sqlite (для локальной разработки) или postgresql (для сервера компании)
DB_ENGINE=sqlite
DB_NAME=helpes_db
DB_USER=helpes_user
DB_PASSWORD=change_me
DB_HOST=127.0.0.1
DB_PORT=5432

# Бизнес-настройки Helpes
# Через сколько часов без обновлений открытая заявка помечается как «требующая внимания»
STALE_TICKET_HOURS=24
# Ограничение отправки открытой формы с одного IP/сессии (заявок в минуту)
PUBLIC_FORM_RATE_LIMIT=5