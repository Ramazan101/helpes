# ==============================================================================
# Конфигурация окружения Help Desk «Кыргыз Алтын»
# ==============================================================================

# Безопасность и режим отладки
# В производственной среде обязательно замените ключ и установите DJANGO_DEBUG=False
DJANGO_SECRET_KEY=change-me-in-production-use-a-long-random-secret-key
DJANGO_DEBUG=True

# Сетевые адреса:
# Для локальной разработки:
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# Для Production на EC2 по привязанному Elastic IP (15.135.104.47):
# DJANGO_ALLOWED_HOSTS=15.135.104.47,127.0.0.1,localhost
# DJANGO_CSRF_TRUSTED_ORIGINS=https://15.135.104.47

# Куки и HTTPS:
# Установите True после включения HTTPS на сервере
DJANGO_SECURE_COOKIES=False

# Настройки портов и SSL для Docker Nginx (опционально)
# NGINX_PORT=80
# NGINX_SSL_PORT=443
# CERTBOT_CONF_DIR=/etc/letsencrypt
# CERTBOT_WWW_DIR=/var/www/certbot

# Настройки базы данных
# Допустимые значения DB_ENGINE: sqlite (для локальной разработки) или postgresql (для сервера компании)
DB_ENGINE=sqlite
DB_NAME=helpes_db
DB_USER=helpes_user
DB_PASSWORD=change_me_strong_db_password
DB_HOST=127.0.0.1
DB_PORT=5432

# Бизнес-настройки Help Desk
# Через сколько часов без обновлений открытая заявка помечается как «требующая внимания»
STALE_TICKET_HOURS=24
# Ограничение отправки открытой формы с одного IP/сессии (заявок в минуту)
PUBLIC_FORM_RATE_LIMIT=5

# Настройки AI-помощника самообслуживания (Helpes AI Assistant)
# Для работы ИИ укажите AI_ASSISTANT_ENABLED=True и задайте AI_API_KEY (например, OpenRouter)
AI_ASSISTANT_ENABLED=True
AI_API_KEY=your_openrouter_api_key_here
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=openrouter/free
AI_ASSISTANT_TIMEOUT=15
AI_ASSISTANT_MAX_MESSAGE_LENGTH=1000
AI_ASSISTANT_MAX_HISTORY=6
AI_ASSISTANT_RATE_LIMIT=15

# Web Push (VAPID) Settings
# Генерация ключей: python -c "from py_vapid import Vapid; v = Vapid(); v.generate_keys(); print('PUB:', v.public_key.to_string()); print('PRIV:', v.private_key.to_string())"
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_CLAIMS_EMAIL=mailto:admin@kyrgyzaltyn.kg

# URL бэкенда для десктопного виджета Tauri (по умолчанию http://127.0.0.1:8000)
# В продакшене: HELPDESK_BACKEND_URL=https://15.135.104.47
# Email администратора для уведомлений Let's Encrypt:
# CERTBOT_EMAIL=ryskulovramazan8@gmail.com
